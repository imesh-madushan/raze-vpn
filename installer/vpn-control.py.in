#!/usr/bin/python3 -I
"""Fixed-purpose, root-owned control for this account's VPN."""
import fcntl
import os
from pathlib import Path
import signal
import re
import subprocess as sp
import sys
import time

ACCOUNT = @ACCOUNT@
UID = @UID@
GID = @GID@
CONFIG = Path(@CONFIG@)
BINARY = @BINARY@
HOME = Path(@HOME@)
UNIT = 'raze-vpn.service'
SESSION = '/usr/local/libexec/raze-vpn-session.py'


def checked(args):
    result = sp.run(args, capture_output=True, text=True, timeout=35)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or 'VPN operation failed')
    return result.stdout.strip()


def manual_sessions():
    for p in Path('/proc').glob('[0-9]*/cmdline'):
        try:
            argv = p.read_bytes().split(b'\0')
            if (str(HOME / 'vpn/run-ipv4-vpn.py').encode() in argv
                    and str(HOME / 'vpn/tun.json').encode() in argv
                    and p.parent.stat().st_uid == 0):
                yield int(p.parent.name)
        except (OSError, ValueError):
            pass


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Administrative authorization is required.')
    caller = os.environ.get('PKEXEC_UID', os.environ.get('SUDO_UID', '0'))
    if caller not in ('0', str(UID)):
        raise RuntimeError('This controller belongs to another account.')
    if sys.argv[1:] == ['stop']:
        name = None
    elif len(sys.argv) == 3 and sys.argv[1] in ('start', 'test') and re.fullmatch(r'[A-Za-z0-9_-]{1,64}', sys.argv[2]):
        name = sys.argv[2]
    else:
        raise RuntimeError('Allowed operations: stop, start PROFILE, test PROFILE')
    runtime = Path('/run/raze-vpn')
    runtime.mkdir(mode=0o700, exist_ok=True)
    import stat
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
        raise RuntimeError('Unsafe VPN runtime directory.')
    fd = os.open(runtime / 'control.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if sys.argv[1] == 'stop':
            state = checked(['/usr/bin/systemctl', 'show', UNIT, '-p', 'LoadState', '--value'])
            if state != 'not-found':
                checked(['/usr/bin/systemctl', 'stop', UNIT])
            # Also support the terminal launcher created before the bar UI.
            sessions = list(manual_sessions())
            for pid in sessions:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            for _ in range(100):
                if not set(sessions).intersection(manual_sessions()):
                    break
                time.sleep(0.1)
            else:
                raise RuntimeError('VPN is still stopping; see its runtime log.')
            checked(['/usr/bin/python3', '-I', SESSION, '--restore'])
            print('Disconnected. Previous IPv6 settings restored by the session helper.')
            return
        if Path('/sys/class/net/singtun0').exists():
            raise RuntimeError('A VPN tunnel is already running. Disconnect it first.')
        profile = CONFIG / 'profiles' / (name + '.json')
        if profile.is_symlink() or not profile.is_file():
            raise RuntimeError('The profile must be a regular file in the configured profiles directory.')
        checked(['/usr/bin/runuser', '-u', ACCOUNT, '--', BINARY, 'check', '-c', str(profile)])
        args = ['/usr/bin/systemd-run', '--unit=' + UNIT, '--collect',
                '--description=VPN profile: ' + name, '--property=Restart=no',
                '--property=KillMode=mixed', '--property=KillSignal=SIGTERM',
                '--property=TimeoutStopSec=25s', '--property=SuccessExitStatus=130 143',
                '--property=UMask=0077']
        if sys.argv[1] == 'test':
            args += ['--property=RuntimeMaxSec=45s']
        args += ['/usr/bin/python3', '-I', SESSION, str(profile), BINARY, str(UID), str(GID)]
        checked(args)
        print('VPN started' + (' for a 45-second test.' if sys.argv[1] == 'test' else '.'))


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, sp.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
